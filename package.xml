<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>atreus</name>
  <version>0.0.0</version>
  <description>The Atreus Package in ROS2</description>
  <maintainer email="leanderdsouza1234@gmail.com">Leander-Stephen-D'Souza</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_lint_cmake</test_depend>
  <test_depend>ament_mypy</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>

  <build_depend>ament_cmake</build_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros_gz</exec_depend>

	<exec_depend>xacro</exec_depend>
	<exec_depend>slam_toolbox</exec_depend>
	<exec_depend>nav2_lifecycle_manager</exec_depend>
	<exec_depend>nav2_amcl</exec_depend>
	<exec_depend>nav2_controller</exec_depend>
	<exec_depend>nav2_planner</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>

  <!-- Custom dependencies -->
  <exec_depend>key_teleop_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
